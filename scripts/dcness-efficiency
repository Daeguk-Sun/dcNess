#!/usr/bin/env bash
# dcNess efficiency wrapper — Claude Code 세션 JSONL 토큰/비용 요약.
#
# 출처 (attribution): jha0313/skills_repo `improve-token-efficiency` (DCN-CHG-20260430-08).
#
# 사용:
#   "${CLAUDE_PLUGIN_ROOT:-...}/scripts/dcness-efficiency" analyze [args]

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(dirname "$SCRIPT_DIR")"
EFF_DIR="$PLUGIN_ROOT/harness/efficiency"

if [ "$#" -lt 1 ]; then
    echo "usage: dcness-efficiency analyze [--repo PATH] [--out PATH]" >&2
    exit 1
fi

cmd="$1"
shift

case "$cmd" in
    analyze|summary)
        exec python3 "$EFF_DIR/analyze_sessions.py" "$@"
        ;;
    dashboard|patterns|patterns-dashboard|full)
        echo "[dcness-efficiency] '$cmd' was removed from plugin runtime; use analyze or summary." >&2
        exit 2
        ;;
    *)
        echo "unknown subcommand: $cmd" >&2
        exit 1
        ;;
esac
