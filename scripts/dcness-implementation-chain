#!/usr/bin/env bash
# Run a dcNess implementation step through the configured provider chain.
#
# Headless fallback is only allowed when a provider fails before workspace
# mutation. Recoverable post-mutation failures continue with the same provider
# in the same workspace; exhaustion stops without revert or cross-provider
# fallback so the caller can inspect the preserved diff.

set -uo pipefail

usage() {
  cat <<'USAGE'
Usage:
  dcness-implementation-chain <agent> [MODE] --prompt-file <file> [--provider <provider>] [--provider-provenance <routing|explicit>] [--chain-state <file>] [--project-root <dir>]

Agents:
  build-worker

Providers:
  headless-chain    Codex headless -> Claude headless -> Claude main fallback
  claude-headless   Claude headless -> Claude main fallback
  claude            Claude main fallback only

Options:
  --prompt-file, -p   File containing the caller prompt.
  --provider          Override local implementation routing.
  --provider-provenance  Provider origin. Explicit selections bypass chain cache.
  --chain-state       Active story-runner state. Enables impl-loop chain cache.
  --project-root, -C  Repository root. Default: git rev-parse --show-toplevel.
  --helper            dcness-helper path. Default: sibling script.
  --help, -h          Show this help.

Environment:
  DCNESS_IMPLEMENTATION_RECOVERY_LIMIT  Same-provider continuation attempts
      after recoverable mutation failures. Default: 2.

Exit codes:
  0   Headless provider completed and recorded end-step.
  75  Chain reached Claude main. Caller must run the main Agent path and record
      end-step with --provider claude-main.

Raw provider logs are preserved under the active run directory in headless-logs/.
USAGE
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi

if [ $# -lt 1 ]; then
  usage >&2
  exit 2
fi

AGENT="$1"
shift

case "$AGENT" in
  build-worker) ;;
  *)
    echo "[dcness-implementation-chain] unsupported agent: $AGENT" >&2
    exit 2
    ;;
esac

MODE=""
if [ $# -gt 0 ] && [[ "${1:-}" != -* ]]; then
  MODE="$1"
  shift
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/lib/headless_context.sh"
PROJECT_ROOT=""
PROMPT_FILE=""
HELPER="$SCRIPT_DIR/dcness-helper"
PROVIDER=""
PROVIDER_ARG_SEEN=0
PROVIDER_PROVENANCE=""
CHAIN_STATE=""
RECOVERY_LIMIT="${DCNESS_IMPLEMENTATION_RECOVERY_LIMIT:-2}"

abs_path() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$(pwd)" "$1" ;;
  esac
}

while [ $# -gt 0 ]; do
  case "$1" in
    --prompt-file|-p)
      PROMPT_FILE="${2:-}"
      shift 2
      ;;
    --provider)
      PROVIDER="${2:-}"
      PROVIDER_ARG_SEEN=1
      shift 2
      ;;
    --provider-provenance)
      PROVIDER_PROVENANCE="${2:-}"
      shift 2
      ;;
    --chain-state)
      CHAIN_STATE="${2:-}"
      shift 2
      ;;
    --project-root|-C)
      PROJECT_ROOT="${2:-}"
      shift 2
      ;;
    --helper)
      HELPER="${2:-}"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "[dcness-implementation-chain] unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [ -z "$PROMPT_FILE" ] || [ ! -f "$PROMPT_FILE" ]; then
  echo "[dcness-implementation-chain] --prompt-file is required and must exist" >&2
  exit 2
fi
PROMPT_FILE="$(abs_path "$PROMPT_FILE")"

if [ -z "$PROJECT_ROOT" ]; then
  PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
fi
if [ ! -d "$PROJECT_ROOT" ]; then
  echo "[dcness-implementation-chain] project root not found: $PROJECT_ROOT" >&2
  exit 2
fi
PROJECT_ROOT="$(cd "$PROJECT_ROOT" && pwd)"
HELPER="$(abs_path "$HELPER")"
if [ -n "$CHAIN_STATE" ]; then
  CHAIN_STATE="$(abs_path "$CHAIN_STATE")"
  if [ ! -f "$CHAIN_STATE" ]; then
    echo "[dcness-implementation-chain] chain state not found: $CHAIN_STATE" >&2
    exit 2
  fi
fi

if [ -z "$PROVIDER_PROVENANCE" ]; then
  if [ "$PROVIDER_ARG_SEEN" -eq 1 ]; then
    PROVIDER_PROVENANCE="explicit"
  else
    PROVIDER_PROVENANCE="routing"
  fi
fi
case "$PROVIDER_PROVENANCE" in
  routing|explicit) ;;
  *)
    echo "[dcness-implementation-chain] --provider-provenance must be routing or explicit: $PROVIDER_PROVENANCE" >&2
    exit 2
    ;;
esac

if [ ! -x "$HELPER" ]; then
  echo "[dcness-implementation-chain] helper not executable: $HELPER" >&2
  exit 2
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "[dcness-implementation-chain] python3 not found; required for routing and context resolution" >&2
  exit 127
fi

case "$RECOVERY_LIMIT" in
  ''|*[!0-9]*)
    echo "[dcness-implementation-chain] DCNESS_IMPLEMENTATION_RECOVERY_LIMIT must be a non-negative integer: $RECOVERY_LIMIT" >&2
    exit 2
    ;;
esac

cd "$PROJECT_ROOT"

dcness_resolve_headless_context "dcness-implementation-chain" "$PROJECT_ROOT" "$SCRIPT_DIR"

git_status_without_harness_state() {
  git -C "$PROJECT_ROOT" status --porcelain=v1 -uall 2>/dev/null \
    | sed '/^.. \.claude\/harness-state\//d' \
    | sed '/^.. \.dcness-work\/headless-logs\//d' \
    | sed '/^.. \.dcness-work\/provider-failure-cache\//d' \
    | sed '/^.. \.dcness-work\/story-run/d' || true
}

CACHE_BYPASS_REASON=""
if [ -n "$CHAIN_STATE" ] && [ "$PROVIDER_PROVENANCE" = "explicit" ]; then
  CACHE_BYPASS_REASON="provenance=explicit"
fi
if [ -n "$CHAIN_STATE" ] && [ -n "${DCNESS_CODEX_PERMISSION_RECEIPT:-}" ]; then
  CACHE_BYPASS_REASON="permission-retry"
fi

provider_cache_check() {
  local stage="$1"
  local entry=""
  local rc=0
  local fields=""
  local category=""
  local first_raw_log=""
  local scope=""
  local diagnostic=""

  [ -n "$CHAIN_STATE" ] || return 1
  [ -z "$CACHE_BYPASS_REASON" ] || return 1
  entry="$(
    PYTHONPATH="$SCRIPT_DIR/..${PYTHONPATH:+:$PYTHONPATH}" \
      python3 -m harness.provider_failure_cache check \
        --state "$CHAIN_STATE" \
        --project-root "$PROJECT_ROOT" \
        --provider "$stage"
  )"
  rc=$?
  if [ "$rc" -eq 3 ]; then
    return 1
  fi
  if [ "$rc" -ne 0 ]; then
    echo "[dcness-implementation-chain] provider cache check failed for $stage; refusing ambiguous chain state." >&2
    return 2
  fi
  fields="$(printf '%s' "$entry" | python3 -c '
import json, sys
entry = json.load(sys.stdin)
print(entry.get("category", ""))
print(entry.get("raw_log", ""))
print(entry.get("scope", ""))
')"
  category="$(printf '%s\n' "$fields" | sed -n '1p')"
  first_raw_log="$(printf '%s\n' "$fields" | sed -n '2p')"
  scope="$(printf '%s\n' "$fields" | sed -n '3p')"
  diagnostic="$RAW_LOG_DIR/chain-cache-skip-${stage}-${AGENT}${MODE:+-$MODE}-$$.log"
  dcness_write_headless_context_header "dcness-implementation-chain" "$diagnostic"
  {
    printf 'PROVIDER_CACHE_HIT\n'
    printf 'provider=%s\n' "$stage"
    printf 'category=%s\n' "$category"
    printf 'first_raw_log=%s\n' "$first_raw_log"
    printf 'scope=%s\n' "$scope"
    printf 'provenance=%s\n' "$PROVIDER_PROVENANCE"
  } >> "$diagnostic"
  echo "[dcness-implementation-chain] PROVIDER_CACHE_HIT provider=$stage category=$category first_raw_log=$first_raw_log scope=$scope diagnostic=$diagnostic" >&2
  return 0
}

provider_cache_clear() {
  local stage="$1"
  [ -n "$CHAIN_STATE" ] || return 0
  PYTHONPATH="$SCRIPT_DIR/..${PYTHONPATH:+:$PYTHONPATH}" \
    python3 -m harness.provider_failure_cache clear \
      --state "$CHAIN_STATE" \
      --project-root "$PROJECT_ROOT" \
      --provider "$stage" >/dev/null 2>&1 || true
}

ROUTING_INFO="$(
  PYTHONPATH="$SCRIPT_DIR/.." python3 - "$AGENT" "$PROVIDER" <<'PY'
import sys

from harness.agent_routing import (
    VALID_IMPLEMENTATION_PROVIDERS,
    implementation_provider_chain,
    resolve_provider,
)

agent = sys.argv[1]
requested = sys.argv[2]
try:
    provider = requested or resolve_provider(agent)
except ValueError as exc:
    print(
        f"[dcness-implementation-chain] routing config rejected: {exc}",
        file=sys.stderr,
    )
    sys.exit(2)
if provider not in VALID_IMPLEMENTATION_PROVIDERS:
    allowed = "|".join(VALID_IMPLEMENTATION_PROVIDERS)
    print(
        f"[dcness-implementation-chain] unsupported implementation provider: "
        f"{provider} (allowed: {allowed})",
        file=sys.stderr,
    )
    sys.exit(2)
print(provider)
for stage in implementation_provider_chain(provider):
    print(stage)
PY
)"
ROUTING_RC=$?
if [ "$ROUTING_RC" -ne 0 ]; then
  exit "$ROUTING_RC"
fi

PROVIDER="$(printf '%s\n' "$ROUTING_INFO" | sed -n '1p')"
STAGES_RAW="$(printf '%s\n' "$ROUTING_INFO" | sed '1d')"
STAGES=()
while IFS= read -r STAGE_LINE; do
  [ -n "$STAGE_LINE" ] || continue
  STAGES+=("$STAGE_LINE")
done <<EOF
$STAGES_RAW
EOF

if [ "${#STAGES[@]}" -eq 0 ]; then
  echo "[dcness-implementation-chain] provider resolved to empty chain: $PROVIDER" >&2
  exit 2
fi

recovery_eligible() {
  case "$1" in
    timeout|idle_timeout|empty_output|boundary_violation|tdd_guard) return 0 ;;
    *) return 1 ;;
  esac
}

write_recovery_prompt() {
  local output="$1"
  local stage="$2"
  local category="$3"
  local raw_log="$4"
  local attempt="$5"
  {
    echo "----- BEGIN ORIGINAL TASK -----"
    cat "$PROMPT_FILE"
    echo "----- END ORIGINAL TASK -----"
    echo
    echo "----- AUTOMATIC RECOVERY -----"
    echo "The same $stage worker is continuing attempt $attempt in the same workspace."
    echo "Failure category: $category"
    echo "Previous raw log: $raw_log"
    echo "Inspect the existing diff and raw log, preserve valid work, and finish the original task."
    echo "Fix the failure's root cause and rerun the relevant checks; mutation-time boundary and TDD guards will run again."
    echo "Do not widen a hard boundary, add a tdd-exempt marker automatically, revert valid work, or ask the user about a routine mechanical recovery."
    echo "Only report a need for user input if product meaning or authority must change."
    echo "----- END AUTOMATIC RECOVERY -----"
  } > "$output"
}

record_exhausted_boundary_block() {
  local stage="$1"
  local raw_log="$2"
  [ -n "$RESOLVED_SID" ] && [ -n "$RESOLVED_RID" ] || return 0
  PYTHONPATH="$SCRIPT_DIR/..${PYTHONPATH:+:$PYTHONPATH}" \
    python3 - "$RESOLVED_SID" "$RESOLVED_RID" "$AGENT" "$MODE" "$stage" "$raw_log" <<'PY' || true
import sys
from harness.session_state import transition

sid, rid, agent, mode, provider, raw_log = sys.argv[1:7]
transition(
    sid,
    "run_blocked",
    run_id=rid,
    category="worker_boundary",
    agent=agent,
    mode=mode or None,
    provider=provider,
    reason="mutation-time boundary recovery exhausted",
    raw_log=raw_log,
)
PY
}

run_headless_stage() {
  local stage="$1"
  local wrapper=""
  local after_status=""
  local after_head=""
  local stage_initial_status=""
  local stage_initial_head=""
  local log=""
  local failure_file=""
  local failure_info=""
  local failure_category=""
  local failure_raw_log=""
  local record_rc=0
  local rc=0
  local attempt=0
  local prompt_path="$PROMPT_FILE"
  local recovery_prompt=""
  local cmd=()

  case "$stage" in
    codex-headless)
      wrapper="$SCRIPT_DIR/dcness-codex-worker"
      ;;
    claude-headless)
      wrapper="$SCRIPT_DIR/dcness-claude-worker"
      ;;
    *)
      echo "[dcness-implementation-chain] unsupported headless stage: $stage" >&2
      return 2
      ;;
  esac

  stage_initial_status="$(git_status_without_harness_state)"
  stage_initial_head="$(git -C "$PROJECT_ROOT" rev-parse --verify HEAD 2>/dev/null || true)"

  while true; do
    log="$RAW_LOG_DIR/chain-${stage}-${AGENT}${MODE:+-$MODE}-attempt-$((attempt + 1))-$$.log"
    failure_file="$(mktemp "${TMPDIR:-/tmp}/dcness-provider-failure-${stage}.XXXXXX")"
    dcness_write_headless_context_header "dcness-implementation-chain" "$log"

    cmd=("$wrapper" "$AGENT")
    if [ -n "$MODE" ]; then
      cmd+=("$MODE")
    fi
    cmd+=(--prompt-file "$prompt_path" --project-root "$PROJECT_ROOT" --helper "$HELPER")

    {
      printf 'PROVIDER: %s\n' "$stage"
      printf 'ATTEMPT: %s\n' "$((attempt + 1))"
      printf 'COMMAND:'
      printf ' %s' "${cmd[@]}"
      printf '\n'
    } >> "$log"

    DCNESS_MUTATION_BASE_HEAD="$stage_initial_head" \
      DCNESS_RECOVERY_OWNER=implementation-chain \
      DCNESS_PROVIDER_FAILURE_FILE="$failure_file" \
      "${cmd[@]}" >> "$log" 2>&1
    rc=$?

    after_status="$(git_status_without_harness_state)"
    after_head="$(git -C "$PROJECT_ROOT" rev-parse --verify HEAD 2>/dev/null || true)"
    if [ "$rc" -eq 0 ]; then
      if [ -n "$CACHE_BYPASS_REASON" ]; then
        provider_cache_clear "$stage"
      fi
      rm -f "$failure_file"
      [ -z "$recovery_prompt" ] || rm -f "$recovery_prompt"
      return 0
    fi

    failure_category=""
    failure_raw_log="$log"
    if [ -s "$failure_file" ]; then
      failure_info="$(cat "$failure_file")"
      failure_category="$(printf '%s' "$failure_info" | python3 -c '
import json, sys
print(json.load(sys.stdin).get("category", ""))
' 2>/dev/null || true)"
      failure_raw_log="$(printf '%s' "$failure_info" | python3 -c '
import json, sys
print(json.load(sys.stdin).get("raw_log", ""))
' 2>/dev/null || printf '%s' "$log")"
      [ -n "$failure_raw_log" ] || failure_raw_log="$log"
    fi

    if [ "$stage_initial_status" != "$after_status" ] || [ "$stage_initial_head" != "$after_head" ]; then
      if recovery_eligible "$failure_category" && [ "$attempt" -lt "$RECOVERY_LIMIT" ]; then
        attempt=$((attempt + 1))
        [ -z "$recovery_prompt" ] || rm -f "$recovery_prompt"
        recovery_prompt="$(mktemp "${TMPDIR:-/tmp}/dcness-recovery-${stage}.XXXXXX")"
        write_recovery_prompt \
          "$recovery_prompt" "$stage" "$failure_category" "$failure_raw_log" "$attempt"
        prompt_path="$recovery_prompt"
        echo "[dcness-implementation-chain] RECOVERY provider=$stage category=$failure_category attempt=$attempt/$RECOVERY_LIMIT workspace=preserved guard=recheck" >&2
        rm -f "$failure_file"
        continue
      fi

      if [ "$failure_category" = "boundary_violation" ]; then
        record_exhausted_boundary_block "$stage" "$failure_raw_log"
      fi
      echo "[dcness-implementation-chain] BLOCKED: provider $stage changed workspace and recovery stopped (category=${failure_category:-unclassified}, attempts=$attempt/$RECOVERY_LIMIT); no cross-provider fallback or revert." >&2
      echo "[dcness-implementation-chain] raw log: $failure_raw_log" >&2
      git -C "$PROJECT_ROOT" status --short >&2 || true
      rm -f "$failure_file"
      [ -z "$recovery_prompt" ] || rm -f "$recovery_prompt"
      exit 1
    fi

    if [ -n "$CHAIN_STATE" ] && [ -z "$CACHE_BYPASS_REASON" ] && [ -s "$failure_file" ]; then
      PYTHONPATH="$SCRIPT_DIR/..${PYTHONPATH:+:$PYTHONPATH}" \
        python3 -m harness.provider_failure_cache record \
          --state "$CHAIN_STATE" \
          --project-root "$PROJECT_ROOT" \
          --provider "$stage" \
          --failure-file "$failure_file" >/dev/null
      record_rc=$?
      if [ "$record_rc" -eq 0 ]; then
        echo "[dcness-implementation-chain] provider cache recorded provider=$stage category=$failure_category" >&2
      elif [ "$record_rc" -ne 3 ]; then
        echo "[dcness-implementation-chain] provider cache record failed for $stage; continuing without memoization." >&2
      fi
    fi
    rm -f "$failure_file"
    [ -z "$recovery_prompt" ] || rm -f "$recovery_prompt"

    echo "[dcness-implementation-chain] provider $stage failed before workspace mutation (exit $rc, category=${failure_category:-unclassified}); continuing. raw log: $log" >&2
    return "$rc"
  done
}

for STAGE in "${STAGES[@]}"; do
  case "$STAGE" in
    codex-headless|claude-headless)
      if [ -n "$CACHE_BYPASS_REASON" ]; then
        echo "[dcness-implementation-chain] provider cache bypass: $CACHE_BYPASS_REASON provider=$STAGE provenance=$PROVIDER_PROVENANCE" >&2
      else
        provider_cache_check "$STAGE"
        CACHE_CHECK_RC=$?
        if [ "$CACHE_CHECK_RC" -eq 0 ]; then
          continue
        fi
        if [ "$CACHE_CHECK_RC" -eq 2 ]; then
          exit 2
        fi
      fi
      run_headless_stage "$STAGE"
      STAGE_RC=$?
      if [ "$STAGE_RC" -eq 0 ]; then
        exit 0
      fi
      ;;
    claude-main)
      echo "[dcness-implementation-chain] FALLBACK_TO_CLAUDE_MAIN: provider $PROVIDER reached Claude main for ${AGENT}${MODE:+ $MODE}." >&2
      echo "[dcness-implementation-chain] Run the normal Claude Agent path, then record end-step with --provider claude-main." >&2
      exit 75
      ;;
    *)
      echo "[dcness-implementation-chain] unknown provider chain stage: $STAGE" >&2
      exit 2
      ;;
  esac
done

echo "[dcness-implementation-chain] provider chain exhausted without success: $PROVIDER" >&2
exit 1
