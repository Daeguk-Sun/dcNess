#!/bin/sh
# commit-msg hook — git-spec 커밋 제목 형식 검증 (thin shim)
# 규칙 정의: docs/plugin/git-spec.md §2 (SSOT)
#
# 본 hook 은 plugin SSOT 에서 검증 스크립트를 직접 호출 — 사용자 repo 에 mjs 복사 X (#198).
# init-dcness 가 매 실행마다 본 shim 을 .git/hooks/commit-msg 로 always-overwrite — plugin
# 업데이트가 자동 hook 갱신.
#
# Plugin root 동적 resolve 우선순위:
#   1. CLAUDE_PLUGIN_ROOT 환경변수 (Claude Code 가 set)
#   2. ~/.claude/plugins/cache/dcness/dcness/* 의 최신 디렉토리 (cache lookup)
#   3. dcNess self repo 의 scripts/check_git_naming.mjs

COMMIT_TITLE=$(head -1 "$1")

# 머지 커밋 면제
if echo "$COMMIT_TITLE" | grep -qE "^Merge (branch|pull request)"; then
  exit 0
fi

resolve_plugin_root() {
  # 우선순위 (이슈 #419 자매):
  # 1. git toplevel — dcNess self repo 안에서는 checkout의 최신 룰이 최우선.
  #    dcness self 작업 시 자기 저장소의 최신 룰 적용. 외부 활성 프로젝트는 mjs 사본 부재 → 자연스럽게 다음 후보로 fall through.
  # 2. CLAUDE_PLUGIN_ROOT — CC plug-in hook 컨텍스트에서 자동 설정.
  # 3. plug-in cache — 위 둘 다 부재 시 최후 fallback.
  self_root="$(git rev-parse --show-toplevel 2>/dev/null)"
  if [ -f "$self_root/scripts/check_git_naming.mjs" ]; then
    echo "$self_root"
    return 0
  fi
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -d "${CLAUDE_PLUGIN_ROOT}/scripts" ]; then
    echo "${CLAUDE_PLUGIN_ROOT}"
    return 0
  fi
  cache_dir="${HOME}/.claude/plugins/cache/dcness/dcness"
  if [ -d "$cache_dir" ]; then
    latest=$(ls -1 "$cache_dir" 2>/dev/null | sort -V | tail -1)
    if [ -n "$latest" ] && [ -d "$cache_dir/$latest/scripts" ]; then
      echo "$cache_dir/$latest"
      return 0
    fi
  fi
  return 1
}

PLUGIN_ROOT=$(resolve_plugin_root)
if [ -z "$PLUGIN_ROOT" ]; then
  echo "[commit-msg] WARN — plugin root 미발견 (plugin 미설치 또는 cache 비정상). hook skip." >&2
  exit 0
fi

record_guard_hit() {
  if PYTHONPATH="${PLUGIN_ROOT}:${PYTHONPATH:-}" python3 -m harness.session_state is-active >/dev/null 2>&1; then
    :
  elif PYTHONPATH="${PLUGIN_ROOT}:${PYTHONPATH:-}" python3 -m harness.session_state is-self >/dev/null 2>&1; then
    :
  else
    return 0
  fi
  PYTHONPATH="${PLUGIN_ROOT}:${PYTHONPATH:-}" python3 -m harness.guard_telemetry record-hit \
    --guard git-commit-msg \
    --category "$1" \
    --detail "$2" \
    --source git_hook \
    --session-id "${DCNESS_SESSION_ID:-}" \
    --run-id "${DCNESS_RUN_ID:-}" >/dev/null 2>&1 || true
}

# 1. git-naming 검증 — TDD chain 폐기 (v0.2.16 — PreToolUse hook 으로 이전)
# node 부재 시 fail-open — node 미설치(exit 127)를 형식 위반(exit 1)과 구분해 WARN + skip.
# plugin hook 계열의 fail-open(부재/크래시 시 allow) 설계와 일관 — node 미설치 기계에서
# 활성화 직후 모든 commit 이 차단되는 것을 막는다.
if command -v node >/dev/null 2>&1; then
  if ! node "$PLUGIN_ROOT/scripts/check_git_naming.mjs" --title "$COMMIT_TITLE"; then
    record_guard_hit "git_naming" "commit title rejected: $COMMIT_TITLE"
    exit 1
  fi
else
  echo "[commit-msg] WARN — node 미설치. git-naming 검증 skip (fail-open)." >&2
fi
